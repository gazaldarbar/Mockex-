{
  "name": "mockex",
  "version": "1.0.0",
  "private": true,
  "description": "Mockex: live crypto paper trading with a Liquid Glass interface. Practice only.",
  "scripts": {
    "test": "node --test tests/engine.test.js tests/feed.test.js",
    "serve": "npx http-server www -p 8123 -c-1",
    "e2e": "mkdir -p shots && node tests/e2e/ui-flow.js && node tests/e2e/live-feed.js",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@capacitor/assets": "^3.0.5"
  }
}